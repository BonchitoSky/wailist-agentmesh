# ── Network switch ────────────────────────────────────────────────────────
NETWORK=testnet

# ── Facilitator ───────────────────────────────────────────────────────────
FACILITATOR_URL=https://facilitator.goplausible.xyz
FEE_PAYER=

# ── algod (optional overrides) ───────────────────────────────────────────
ALGOD_URL=
ALGOD_TOKEN=

# ── Wallet encryption ─────────────────────────────────────────────────────
# Exactly 32 characters, e.g. `openssl rand -hex 16`.
ENCRYPTION_KEY=

# ── Service ports & public URLs ──────────────────────────────────────────
MERCHANT_PORT=4021
ORCHESTRATOR_PORT=4020
PUBLIC_MERCHANT_URL=http://localhost:4021
PUBLIC_ORCHESTRATOR_URL=http://localhost:4020

# ── Pricing ───────────────────────────────────────────────────────────────
MERCHANT_PRICE_USDC_MICROS=50000
ORCHESTRATOR_PRICE_USDC_MICROS=

# ── Wallets — generate three with backend/cmd/walletgen, see README.md ───
CLIENT_ADDRESS=
CLIENT_ENC_MNEMONIC=
ORCH_WALLET2_ADDRESS=
ORCH_WALLET2_ENC_MNEMONIC=
MERCHANT_WALLET3_ADDRESS=
