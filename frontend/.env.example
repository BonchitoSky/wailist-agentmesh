# Public base URL of the Go backend.
# Inlined into the bundle at BUILD time — a redeploy is required after changing it.
# Leave empty to run the frontend in mock mode (no backend calls).
NEXT_PUBLIC_API_URL=https://wailist-agentmesh-production.up.railway.app

# Public URL of the x402-demo merchant's zero-argument demo route (see
# backend/cmd/x402demo), used by the "Load demo workflow" button on the
# Workflows page. Must be reachable by the BACKEND (not just your browser)
# and not localhost/private — AgentMesh's backend blocks those (SSRF
# guard). Leave unset to default to http://localhost:4021/resume-screen-demo,
# which only works if the backend itself also runs unsandboxed on the same
# machine as the merchant.
NEXT_PUBLIC_X402_DEMO_MERCHANT_URL=
